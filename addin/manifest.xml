<?xml version="1.0" encoding="UTF-8"?>
<!-- Clicky BI Excel add-in. Upload this file in Excel (Home > Add-ins > More add-ins >
     My add-ins > Upload My Add-in), or an IT admin deploys it from the Microsoft 365
     admin center (Settings > Integrated apps). -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="TaskPaneApp">
  <Id>27a20994-541f-4cbc-a871-32341b790144</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Clicky BI</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="Clicky BI" />
  <Description DefaultValue="Lập báo cáo quản trị tháng từ cân đối phát sinh, số do code tính, có công thức truy nguồn và kiểm bẫy." />
  <IconUrl DefaultValue="https://zicky008-forks.github.io/clicky-windows/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://zicky008-forks.github.io/clicky-windows/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://github.com/zicky008-forks/clicky-windows" />
  <AppDomains>
    <AppDomain>https://zicky008-forks.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.7" />
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://zicky008-forks.github.io/clicky-windows/taskpane.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="Title" />
            <Description resid="Description" />
            <LearnMoreUrl resid="Support" />
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="ClickyBI.Group">
                <Label resid="Title" />
                <Icon>
                  <bt:Image size="16" resid="Icon16" />
                  <bt:Image size="32" resid="Icon32" />
                  <bt:Image size="80" resid="Icon80" />
                </Icon>
                <Control xsi:type="Button" id="ClickyBI.Open">
                  <Label resid="Title" />
                  <Supertip>
                    <Title resid="Title" />
                    <Description resid="Description" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="80" resid="Icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ClickyBI</TaskpaneId>
                    <SourceLocation resid="Taskpane" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://zicky008-forks.github.io/clicky-windows/assets/icon-16.png" />
        <bt:Image id="Icon32" DefaultValue="https://zicky008-forks.github.io/clicky-windows/assets/icon-32.png" />
        <bt:Image id="Icon80" DefaultValue="https://zicky008-forks.github.io/clicky-windows/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane" DefaultValue="https://zicky008-forks.github.io/clicky-windows/taskpane.html" />
        <bt:Url id="Support" DefaultValue="https://github.com/zicky008-forks/clicky-windows" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Title" DefaultValue="Clicky BI" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Description" DefaultValue="Lập báo cáo quản trị tháng từ cân đối phát sinh, có công thức truy nguồn và kiểm bẫy." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
